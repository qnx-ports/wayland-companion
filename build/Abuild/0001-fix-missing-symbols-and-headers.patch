From: Felix Xing <fxing@qnx.com>
Date: Fri, 4 Jul 2025 13:05:15 -0400
Subject: [PATCH 1/2] fix missing symbols and headers

---
 src/connection.c          |  4 ++++
 src/wayland-os.c          | 28 ++++++++++++++++++++++++++++
 src/wayland-server-core.h |  6 ++++++
 src/wayland-server.c      | 11 +++++++++++
 4 files changed, 49 insertions(+)

diff --git a/src/connection.c b/src/connection.c
index 3ef8688d..87a29a6b 100644
--- a/src/connection.c
+++ b/src/connection.c
@@ -40,6 +40,10 @@
 #include <time.h>
 #include <ffi.h>
 
+#if defined(__QNX__)
+#include <sys/memstream.h>
+#endif
+
 #include "wayland-util.h"
 #include "wayland-private.h"
 #include "wayland-os.h"
diff --git a/src/wayland-os.c b/src/wayland-os.c
index f00ead4b..876a3fcc 100644
--- a/src/wayland-os.c
+++ b/src/wayland-os.c
@@ -40,6 +40,10 @@
 #include <sys/ucred.h>
 #endif
 
+#if defined(__QNX__)
+#include <sys/ucred.h>
+#endif
+
 #include "wayland-os.h"
 
 /* used by tests */
@@ -106,6 +110,30 @@ wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
 #endif
 	return 0;
 }
+#elif defined(__QNX__)
+int
+wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
+{
+	socklen_t len;
+	struct xucred ucred;
+
+	len = sizeof(ucred);
+	if (getsockopt(sockfd, SOL_LOCAL, LOCAL_PEERCRED, &ucred, &len) < 0) {
+		if (errno != ENOTCONN)
+			return -1;
+		/* LOCAL_PEERCRED will report ENOTCONN for socketpair sockets */
+		*pid = getpid();
+		*uid = getuid();
+		*gid = getgid();
+	} else if (ucred.cr_version != XUCRED_VERSION) {
+		return -1;
+	} else {
+		*uid = ucred.cr_uid;
+		*gid = ucred.cr_gid;
+		*pid = ucred.cr_pid;
+	}
+	return 0;
+}
 #elif defined(SO_PEERCRED)
 int
 wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
diff --git a/src/wayland-server-core.h b/src/wayland-server-core.h
index c2dcc218..ef4b7fed 100644
--- a/src/wayland-server-core.h
+++ b/src/wayland-server-core.h
@@ -327,6 +327,12 @@ void
 wl_client_get_credentials(const struct wl_client *client,
 			  pid_t *pid, uid_t *uid, gid_t *gid);
 
+#if defined(__QNX__)
+void
+wl_client_set_credentials(struct wl_client *client,
+			  pid_t pid, uid_t uid, gid_t gid);
+#endif
+
 int
 wl_client_get_fd(struct wl_client *client);
 
diff --git a/src/wayland-server.c b/src/wayland-server.c
index 72a12018..ad110a26 100644
--- a/src/wayland-server.c
+++ b/src/wayland-server.c
@@ -653,6 +653,17 @@ wl_client_get_credentials(const struct wl_client *client,
 		*gid = client->gid;
 }
 
+#if defined(__QNX__)
+WL_EXPORT void
+wl_client_set_credentials(struct wl_client *client,
+			  pid_t pid, uid_t uid, gid_t gid)
+{
+	client->pid = pid;
+	client->uid = uid;
+	client->gid = gid;
+}
+#endif
+
 /** Get the file descriptor for the client
